# Database (Neon/Supabase free tier for Phases 0-3, AWS RDS from Phase 4)
DATABASE_URL=postgresql://user:password@host:5432/beneflex

# Auth0 (free tier)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://api.beneflex.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Encryption (maps to AWS KMS in Phase 4)
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key

# Frontend
VITE_API_URL=http://localhost:8000
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://api.beneflex.com
